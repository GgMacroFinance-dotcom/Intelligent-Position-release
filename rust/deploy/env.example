# 复制成 rust/.env，填上真实的值。.env 已被 git 忽略，不要提交。
# docker compose 会把这些变量交给容器；ip.yaml 里只写变量名（auth_token_env、api_key_env 等）。

# 访问令牌：容器里监听 0.0.0.0，必须设置。可以用 openssl rand -hex 24 生成。
IP_TOKEN=

# PostgreSQL（docker-compose.yml 里的 postgres 服务）。三个都用 openssl rand -hex 24 生成。
# 只在数据卷第一次建出来时生效；之后要改密码得进库里 ALTER ROLE。
POSTGRES_PASSWORD=
IP_DB_PASSWORD=
# 团队上下文系统的账号；暂时不用可以留空，第一次启动时就不建它（以后要用时手工建，见 docs/ip/deploy-docker.md“团队上下文”）。
TCMS_DB_PASSWORD=

# 团队上下文系统（tcms 服务）：要起它就取消下一行的注释。docker compose 读这个变量决定起哪些可选的服务。
# COMPOSE_PROFILES=tcms
# 每个岗位一个 TCMS 令牌：docker compose run --rm tcms token add --name "I.P. 宏观研报" --role macro，把打印的明文填在这里。
TCMS_TOKEN_MACRO=
# 可选：审核页批准提议时提交者的邮箱；TCMS 镜像从哪个分支或标签构建（默认 main）。
# TCMS_GIT_EMAIL=
# TCMS_REF=main
# 可选：上下文仓库推到自己的 git 远端（GitHub、Gitea 等）。https 地址配一个对这个仓库有写权限的令牌，地址里不要带令牌。
# TCMS_REMOTE=https://github.com/<组织>/<仓库>.git
# TCMS_GIT_TOKEN=
# Gitea、GitLab 写自己的用户名；GitHub 不用写。
# TCMS_GIT_USERNAME=
# 远端的分支，默认和本地同名（新卷是 main）。
# TCMS_REMOTE_BRANCH=
# 多久和远端同步一次（秒），默认 60；0 是只在批准、改单条时同步。
# TCMS_SYNC_SECS=60

# 模型端点（示例配置默认用 OpenAI；换 DeepSeek 时填下面那个）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Finance Macro Data API（mcp_servers.macro，镜像里自带，本机启动）：FRED 数据经 WhichAPI 托管服务取，要 WhichAPI 的 key。
# 填了以后取消 ip.yaml 里 mcp_servers.macro.env_from 的注释；不填也能启动，其余数据照常。
WHICHAPI_API_KEY=
# 可选：SEC 公司财务数据（get_company_concept）要，格式“名字 邮箱”。示例配置的 env_inherit 已经写了它，填上就会传给 macro-mcp；不填也能启动。
SEC_USER_AGENT=

# Slack（用 channels.slack 时）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Codex（用 engines 时；构建镜像要加 INSTALL_CODEX=true）
CODEX_API_KEY=

# 构建参数：true 时镜像里装 Codex
INSTALL_CODEX=false

# 可选：容器整体的资源上限（docker-compose.yml 读这几个变量，不设时用注释里的默认值）。
# 怎么按主机调见 docs/ip/deploy-docker.md“资源上限”。IP_CPUS 不能大于主机核数。
# IP_PIDS_LIMIT=1024
# IP_MEM_LIMIT=2g
# IP_CPUS=1
