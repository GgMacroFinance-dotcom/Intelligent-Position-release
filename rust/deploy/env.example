# 复制成 rust/.env，填上真实的值。.env 已被 git 忽略，不要提交。
# docker compose 会把这些变量交给容器；ip.yaml 里只写变量名（auth_token_env、api_key_env 等）。

# 访问令牌：容器里监听 0.0.0.0，必须设置。可以用 openssl rand -hex 24 生成。
IP_TOKEN=

# PostgreSQL（docker-compose.yml 里的 postgres 服务）。三个都用 openssl rand -hex 24 生成。
# 只在数据卷第一次建出来时生效；之后要改密码得进库里 ALTER ROLE。
POSTGRES_PASSWORD=
IP_DB_PASSWORD=
# 团队上下文系统的账号；暂时不用可以留空，第一次启动时就不建它。
TCMS_DB_PASSWORD=

# 模型端点（示例配置默认用 OpenAI；换 DeepSeek 时填下面那个）
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Finance Macro Data API（mcp_servers.macro，镜像里自带，本机启动）：FRED 数据经 WhichAPI 托管服务取，要 WhichAPI 的 key。
# 填了以后取消 ip.yaml 里 mcp_servers.macro.env_from 的注释；不填也能启动，其余数据照常。
WHICHAPI_API_KEY=
# 可选：SEC 公司财务数据（get_company_concept）要，格式“名字 邮箱”。示例配置的 env_inherit 已经写了它，填上就会传给 macro-mcp；不填也能启动。
SEC_USER_AGENT=

# Slack（用 channels.slack 时）
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Codex（用 engines 时；构建镜像要加 INSTALL_CODEX=true）
CODEX_API_KEY=

# 构建参数：true 时镜像里装 Codex
INSTALL_CODEX=false

# 可选：容器整体的资源上限（docker-compose.yml 读这几个变量，不设时用注释里的默认值）。
# 怎么按主机调见 docs/ip/deploy-docker.md“资源上限”。IP_CPUS 不能大于主机核数。
# IP_PIDS_LIMIT=1024
# IP_MEM_LIMIT=2g
# IP_CPUS=1
