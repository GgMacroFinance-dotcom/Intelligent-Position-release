{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "intelligent-position",
  "version": "0.8.0",
  "identifier": "dev.intelligent-position.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/bundle.mjs",
    "beforeBuildCommand": "node scripts/bundle.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "intelligent-position",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss:; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "和智能岗位的数字员工对话、处理审批、看任务",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
